{
  "name": "@havoc-unleash/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Electron replica of HAVOC Desktop: PKCE auth -> producer -> Supabase bridge, plus anchored overlay/HUD.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "pack": "node ../../scripts/pack-desktop.mjs",
    "ow:start": "npm run build && node ../../scripts/ow-start.mjs",
    "ow:install": "npx install-ow-electron"
  },
  "build": {
    "appId": "app.havocunleash.desktop",
    "productName": "Havoc Unleash",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main.js",
      "dist/runtime-server.cjs",
      "dist/hud-public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/@roamhq/**/*",
      "dist/runtime-server.cjs"
    ],
    "extraResources": [
      { "from": "dist/ow-electron", "to": "ow-electron" },
      { "from": "dist/gep-provider", "to": "gep-provider" }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": "x64"
        }
      ]
    },
    "portable": {
      "artifactName": "Havoc-Unleash-${version}.exe"
    }
  },
  "dependencies": {
    "@roamhq/wrtc": "^0.10.0",
    "koffi": "^2.8.0"
  },
  "optionalDependencies": {
    "@roamhq/wrtc-win32-x64": "0.10.0"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "@types/node": "^20.14.9",
    "@types/ws": "^8.5.10",
    "typescript": "^5.5.4"
  }
}
